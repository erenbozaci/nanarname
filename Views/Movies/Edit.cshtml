@model EksiCaciklar.Models.Movie

@{
    ViewData["Title"] = "Filmi Düzenle";
}

<div class="container mt-4">
    <div class="card shadow border-warning">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">✏️ YÖNETİCİ PANELİ: @Model.Title</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 border-end">
                        <h5 class="text-muted">Film Künyesi</h5>
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="fw-bold"></label>
                            <input asp-for="Title" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Director" class="fw-bold"></label>
                            <input asp-for="Director" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="ImageUrl" class="fw-bold"></label>
                            <input asp-for="ImageUrl" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-primary">Yönetim Değerlendirmesi (0-100)</h5>
                        <div class="alert alert-info py-2"><small>Aşağıdaki 5 kriteri girince ortalama otomatik alınır.</small></div>

                        <div class="mb-2">
                            <label class="small fw-bold">📜 Senaryo</label>
                            <input asp-for="ScoreScenario" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>@Model.ScoreScenario</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">🎭 Oyunculuk</label>
                            <input asp-for="ScoreActing" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>@Model.ScoreActing</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">🎬 Görsellik</label>
                            <input asp-for="ScoreVisuals" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>@Model.ScoreVisuals</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">🎵 Ses & Müzik</label>
                            <input asp-for="ScoreSound" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>@Model.ScoreSound</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">✂️ Kurgu</label>
                            <input asp-for="ScoreEditing" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>@Model.ScoreEditing</output>
                        </div>

                        <hr />

                        <div class="mb-3 bg-light p-3 rounded text-center border">
                            <label class="fw-bold text-muted d-block">Mevcut Halk Puanı</label>

                            <h3 class="text-info display-6 fw-bold">
                                @(Model.VoteCount > 0 ? Model.UserScore.ToString("0.0") : "-")
                            </h3>
                            <small class="text-muted">(@Model.VoteCount kişi oy kullandı)</small>

                            <input type="hidden" asp-for="UserScore" />
                            <input type="hidden" asp-for="VoteCount" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-grid">
                    <button type="submit" class="btn btn-warning btn-lg fw-bold">💾 Değişiklikleri ve Puanları Kaydet</button>
                    <a asp-action="Index" class="btn btn-link text-muted mt-2">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>