@model EksiCaciklar.Models.Movie

@{
    ViewData["Title"] = "Sil: " + Model.Title;
}

<div class="container mt-5 text-center">
    <div class="card shadow border-danger mx-auto" style="max-width: 600px;">
        <div class="card-header bg-danger text-white">
            <h3>⚠️ DİKKAT! Bu işlem geri alınamaz!</h3>
        </div>
        <div class="card-body">
            <h4 class="card-title text-danger mb-4">"@Model.Title" filmini silmek üzeresin.</h4>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-thumbnail mb-3" style="max-height: 200px;" />
            }

            <p class="card-text">
                Bu film, <strong>@Model.CacikScore</strong> Cacık Puanı ile veritabanımızda
                önemli bir yere sahipti. Silersen bir daha geri getiremeyiz.
            </p>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2 d-md-block mt-4">
                    <input type="submit" value="Evet, Sil Gitsin!" class="btn btn-danger btn-lg me-2" />
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>