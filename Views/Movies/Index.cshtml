@model IEnumerable<EksiCaciklar.Models.Movie>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="panel" style="text-align: center; border-color: red; margin-bottom:30px;">
    <h2 style="color: red; text-shadow: 1px 1px 0 yellow; margin-top:0;">🔥 VİZYONDAKİ FELAKETLER 🔥</h2>
    <p style="font-size: 0.9em; color: #aaa;">Aşağıdaki filmler sağlığa zararlı olabilir.</p>
</div>

@foreach (var item in Model)
{
    // Puan durumuna göre renk sınıfı belirle
    string ratingClass = "bad"; // Varsayılan kötü (Kırmızı)
    string ratingText = "%" + (item.CacikScore == -1 ? "0" : item.CacikScore.ToString("0"));
    double width = item.CacikScore == -1 ? 0 : item.CacikScore;

    if (item.CacikScore >= 70) { ratingClass = "good"; } // Yeşil
    else if (item.CacikScore >= 50) { ratingClass = "mid"; } // Sarı

    <div class="movie-card">
        <div class="movie-header">
            <span class="movie-title-badge">@item.Title (@item.ReleaseDate.Year)</span>
            @if (item.CacikScore < 30 && item.CacikScore > -1)
            {
                <span style="animation: blinker 0.5s step-end infinite; color: red; font-weight:bold;">KAÇIN!</span>
            }
        </div>

        <div style="display:flex; gap:15px;">
            <div style="flex:0 0 80px;">
                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/80x120" : item.ImageUrl)"
                     style="width:80px; height:auto; border:1px solid #fff;">
            </div>

            <div style="flex:1;">
                <p style="margin:0 0 5px 0; font-size:0.9em;"><b>Yönetmen:</b> @item.Director</p>
                <p style="font-style: italic; color: #ccc; font-size:0.85em; margin:0;">
                    "@(item.Description != null && item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)"
                </p>
                <a asp-action="Details" asp-route-id="@item.Id" class="retro-button" style="display:inline-block; margin-top:10px; width:auto; font-size:10px;">İNCELE >></a>
            </div>
        </div>

        <div class="rating-wrapper">
            @if (item.CacikScore == -1)
            {
                <div class="rating-fill" style="width: 100%; background: #333; color:gray;">HENÜZ OYLANMADI</div>
            }
            else
            {
                <div class="rating-fill @ratingClass" style="width: @width.ToString("0")%;">@ratingText CACIK</div>
            }
        </div>
    </div>
}

<div style="text-align: center; margin-top: 30px;">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="retro-button" style="width: auto; display: inline-block; background:var(--matrix-green);">[ YENİ FİLM EKLE ]</a>
    }
</div>