@using EksiCaciklar.Models
@model Movie

@{
    ViewData["Title"] = Model.Title;
    bool isAdmin = User.IsInRole("Admin");

    // --- LAMBDA HATASINI ÖNLEYEN GÜVENLİ LİSTE ---
    var voteList = Model.UserVotes as IEnumerable<UserVote> ?? new List<UserVote>();

    // Yorumları filtrele ve sırala
    var yorumlar = voteList.Where(v => !string.IsNullOrEmpty(v.Comment)).OrderByDescending(v => v.Id).ToList();
}

<div class="container mt-5 mb-5 pb-5">

    <div class="row mb-5">
        <div class="col-md-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/300x450" : Model.ImageUrl)" class="img-fluid rounded shadow" style="width:100%; object-fit: cover;">
        </div>
        <div class="col-md-8">
            <h1 class="display-4 fw-bold">@Model.Title</h1>
            <p class="lead text-muted">@Model.Description</p>

            <div class="p-4 rounded text-center text-white mb-4 shadow-sm" style="background: linear-gradient(45deg, #11998e, #38ef7d);">
                <h3>GENEL SKOR</h3>
                <h1 class="display-1 fw-bold">@(Model.CacikScore == -1 ? "-" : Model.CacikScore.ToString("0.0"))</h1>
                <small>@Model.VoteCount kişi oyladı</small>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📊 Puan Detayları</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0 text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Kriter</th>
                                <th>Yönetim</th>
                                <th>Halk</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>📜 Senaryo</td><td>@Model.ScoreScenario</td><td>@Model.UserAvgScenario.ToString("0.0")</td></tr>
                            <tr><td>🎭 Oyunculuk</td><td>@Model.ScoreActing</td><td>@Model.UserAvgActing.ToString("0.0")</td></tr>
                            <tr><td>🎬 Görsellik</td><td>@Model.ScoreVisuals</td><td>@Model.UserAvgVisuals.ToString("0.0")</td></tr>
                            <tr><td>🎵 Ses</td><td>@Model.ScoreSound</td><td>@Model.UserAvgSound.ToString("0.0")</td></tr>
                            <tr><td>✂️ Kurgu</td><td>@Model.ScoreEditing</td><td>@Model.UserAvgEditing.ToString("0.0")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-light mb-5 shadow-sm border-0">
        <div class="card-body p-4">
            @if (User.Identity.IsAuthenticated)
            {
                <h4 class="mb-3 border-bottom pb-2">🗳️ Senin Oyun</h4>
                <form asp-action="Vote" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold d-flex justify-content-between">
                                📜 Senaryo <span class="badge bg-primary" id="val1">50</span>
                            </label>
                            <input type="range" name="sScenario" class="form-range" min="0" max="100" value="50" oninput="document.getElementById('val1').innerText = this.value">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold d-flex justify-content-between">
                                🎭 Oyunculuk <span class="badge bg-primary" id="val2">50</span>
                            </label>
                            <input type="range" name="sActing" class="form-range" min="0" max="100" value="50" oninput="document.getElementById('val2').innerText = this.value">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold d-flex justify-content-between">
                                🎬 Görsellik <span class="badge bg-primary" id="val3">50</span>
                            </label>
                            <input type="range" name="sVisuals" class="form-range" min="0" max="100" value="50" oninput="document.getElementById('val3').innerText = this.value">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold d-flex justify-content-between">
                                🎵 Ses <span class="badge bg-primary" id="val4">50</span>
                            </label>
                            <input type="range" name="sSound" class="form-range" min="0" max="100" value="50" oninput="document.getElementById('val4').innerText = this.value">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold d-flex justify-content-between">
                                ✂️ Kurgu <span class="badge bg-primary" id="val5">50</span>
                            </label>
                            <input type="range" name="sEditing" class="form-range" min="0" max="100" value="50" oninput="document.getElementById('val5').innerText = this.value">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold form-label">Yorumun (İsteğe Bağlı)</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Film hakkında ne düşünüyorsun?"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">✅ Puanı ve Yorumu Gönder</button>
                </form>
            }
            else
            {
                <div class="text-center py-3">
                    <h5>Oy kullanmak için giriş yapmalısın.</h5>
                    <a href="/Identity/Account/Login" class="btn btn-primary px-4">Giriş Yap</a>
                </div>
            }
        </div>
    </div>

    <h3 class="border-bottom pb-2 mb-4">📢 Yorumlar (@yorumlar.Count)</h3>
    @if (yorumlar.Any())
    {
        @foreach (var vote in yorumlar)
        {
            // Kullanıcı kontrolü
            string uName = vote.User?.UserName ?? "Anonim";
            bool isAdmn = vote.User?.Email == "batuhan77demir@gmail.com";

            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title fw-bold mb-0">
                            <i class="fa fa-user-circle text-muted me-2"></i>@uName
                            @if (isAdmn)
                            {
                                <span class="badge bg-warning text-dark ms-2">YÖNETİCİ</span>
                            }
                        </h5>

                        @{
                            double avg = (vote.ScoreScenario + vote.ScoreActing + vote.ScoreVisuals + vote.ScoreSound + vote.ScoreEditing) / 5.0;
                        }
                        <span class="badge bg-secondary rounded-pill">Verdiği Puan: @avg</span>
                    </div>
                    <p class="card-text text-muted fst-italic ps-4 border-start border-4 border-success">
                        "@vote.Comment"
                    </p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center">Henüz yorum yapılmamış. İlk yorumu sen yap!</div>
    }

    <div style="height: 100px;"></div>
</div>