@model EksiCaciklar.Models.Movie

@{
    ViewData["Title"] = "Yeni Film Ekle";
}

<div class="container mt-4">
    <div class="card shadow border-success">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0">🎬 Yeni Film Ekle</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-7 border-end">
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="fw-bold">Film Adı</label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Recep İvedik 7" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Director" class="fw-bold">Yönetmen</label>
                                <input asp-for="Director" class="form-control" />
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="ReleaseDate" class="fw-bold">Vizyon Tarihi</label>
                                <input asp-for="ReleaseDate" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImageUrl" class="fw-bold">Afiş Linki (URL)</label>
                            <input asp-for="ImageUrl" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="fw-bold">Özet / Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <h5 class="text-primary mb-3">Yönetim Değerlendirmesi</h5>
                        <div class="alert alert-info py-2 small">
                            <i class="fa fa-info-circle"></i> Halk puanı, kullanıcılar oy verdikçe otomatik oluşacaktır.
                        </div>

                        <div class="mb-2">
                            <label class="small fw-bold">Senaryo</label>
                            <input asp-for="ScoreScenario" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>0</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Oyunculuk</label>
                            <input asp-for="ScoreActing" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>0</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Görsellik</label>
                            <input asp-for="ScoreVisuals" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>0</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Ses & Müzik</label>
                            <input asp-for="ScoreSound" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>0</output>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Kurgu</label>
                            <input asp-for="ScoreEditing" type="range" class="form-range" min="0" max="100" oninput="this.nextElementSibling.value = this.value">
                            <output>0</output>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>